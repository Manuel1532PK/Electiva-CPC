# MIMETIC IA - variables de entorno (ejemplo)
# Copia este archivo como `.env` y ajusta los valores antes de arrancar el backend.
# El archivo `.env` real está excluido del repositorio por seguridad.

# --- Base de datos ---
# Local con docker-compose.yml: mongodb://localhost:27017
# MongoDB Atlas: mongodb+srv://usuario:password@cluster.mongodb.net
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=mimetic_ai

# --- Seguridad / JWT ---
# Genera una clave propia y larga (por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=cambia-esta-clave-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Opcionales (login social, correo e IA) ---
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Correo: Gmail API (HTTPS)
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
# Correo: SMTP (fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SENDGRID_API_KEY=
FROM_EMAIL=MIMETIC <mimeticvalidated@gmail.com>
# Proveedores de IA (opcionales; el sistema experto funciona con el catálogo local)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
TOGETHER_API_KEY=
# Logging
LOG_LEVEL=INFO
